# Required for tau2-agent (evaluator agent uses Nebius Qwen model)
# Sign up at https://tokenfactory.nebius.com/ to get your API key
NEBIUS_API_KEY=<your_nebius_api_key_here>

# Optional - for user simulation with different providers
ANTHROPIC_API_KEY=<your_key_here>
OPENAI_API_KEY=<your_key_here>

# =============================================================================
# Custom LLM Model Registration
# =============================================================================
# Register custom models with LiteLLM for pricing/token limits
# Format: JSON object mapping model names to their configurations
# Required fields: litellm_provider
# Optional fields: max_tokens, max_input_tokens, max_output_tokens, input_cost_per_token, output_cost_per_token
TAU2_LLM_MODELS={"nebius/Qwen/Qwen3-30B-A3B-Thinking-2507":{"max_tokens":32768,"max_input_tokens":32768,"max_output_tokens":32768,"input_cost_per_token":0.0000001,"output_cost_per_token":0.0000003,"litellm_provider":"nebius"}}

# =============================================================================
# Docker Hub Settings (for pushing images)
# =============================================================================
# Your Docker Hub username (include trailing slash)
DOCKER_REGISTRY=yourusername/

# Image tag
TAG=latest
